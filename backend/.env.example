# Hono 백엔드의 Supabase·Render·Storage·향후 OAuth/PG 연결 환경변수 예시입니다.
# 실제 값은 `.env` 또는 Render Secret에만 넣고 Git·프론트·문서에 기록하지 않습니다.
NODE_ENV=development
PORT=10000
ALLOWED_ORIGINS=http://localhost:3100
AUTH_REDIRECT_ORIGINS=http://localhost:3100
# 개발 화면 확인에서만 true. production에서는 코드가 자동으로 비활성화합니다.
ENABLE_SAMPLE_DATA=true
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# 서버 전용 최고 권한 키이며 VITE_* 또는 브라우저 코드에 절대 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PUBLIC_BACKEND_URL=http://localhost:10000
# Supabase Storage에 미리 생성할 상품 이미지 버킷과 업로드 최대 크기입니다.
PRODUCT_IMAGE_BUCKET=product-images
MAX_IMAGE_BYTES=5242880
# 네이버 로그인은 현재 라우트/UI가 비활성입니다. 별도 브리지 구현 시 아래 위치에만 입력합니다.
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_REDIRECT_URI=https://YOUR-BACKEND.example/api/auth/naver/callback
# PG 미연동 시 not_configured를 유지합니다. TOSS_SECRET_KEY를 넣으면 카드 결제(toss)가 열립니다.
PAYMENT_PROVIDER=not_configured
# developers.tosspayments.com "내 개발정보"에서 발급받은 테스트 시크릿 키(test_sk_...)입니다.
# 실 결제가 절대 발생하지 않는 TEST 모드 전용이며, 절대 프론트/VITE_*/Git에 넣지 않습니다.
TOSS_SECRET_KEY=test_sk_YOUR_TOSS_TEST_SECRET_KEY
