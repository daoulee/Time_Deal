# 프론트가 Render API와 Supabase Auth에 연결할 공개 환경변수 예시입니다.
# VITE_* 값은 브라우저에 공개되므로 service role key나 OAuth secret을 절대 넣지 않습니다.
VITE_API_BASE_URL=https://time-deal.onrender.com
VITE_SUPABASE_URL=https://gkzglohnjhmypebmaaaf.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdremdsb2huamhteXBlYm1hYWFmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2NzU5NzEsImV4cCI6MjEwMjI1MTk3MX0.YxLiKe-jVdrini7-PjAyL7KB1MSXf6ZfeB2o5czjJmY
# 로컬 개발 샘플 확인에서만 true. 운영 빌드에서는 false로 두어 장애를 샘플로 숨기지 않습니다.
VITE_ENABLE_SAMPLE_DATA=false
# 지도 페이지(/map)의 Google Maps JavaScript API 키입니다. Google Cloud Console에서
# Maps JavaScript API를 활성화하고 HTTP 리퍼러 제한을 프론트 도메인으로 걸어두세요.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# developers.tosspayments.com "내 개발정보"에서 발급받은 결제위젯 테스트 클라이언트 키(test_ck_...)입니다.
# 실 결제가 발생하지 않는 TEST 모드 키이며 브라우저에 공개돼도 안전합니다.
VITE_TOSS_CLIENT_KEY=YOUR_TOSS_TEST_CLIENT_KEY
