# 텍스트 파일은 저장소에서 LF로 정규화합니다.
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF를 유지합니다.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 이미지·폰트·압축 파일은 줄바꿈 변환을 하지 않습니다.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
